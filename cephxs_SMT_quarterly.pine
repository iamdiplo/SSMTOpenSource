//@version=6

// - - - - - - - - -
// cephxs / SMT [Quarterly Theory]
//
// SMT divergence between the chart symbol and up to four correlated assets
// (default NQ, ES, YM, RTY), evaluated per QUARTERLY THEORY cycle.
//
// QUARTERLY THEORY (fractal): every cycle splits into four quarters
//   Q1 accumulation | Q2 manipulation | Q3 distribution | Q4 continuation / reversal
//   • 90-Min cycle : 90-minute cycles, 22.5-minute quarters (anchored 18:00 NY)
//   • Daily cycle  : 6-hour quarters  Q1 18-00 | Q2 00-06 | Q3 06-12 | Q4 12-18 (NY)
//   • Weekly cycle : Mon = Q1, Tue = Q2, Wed = Q3, Thu + Fri = Q4 (trading days)
//
// SMT RULE (quarter vs previous quarter)
//   The previous quarter's high / low is the reference level for each asset.
//   • BEARISH SMT: at least one asset SWEEPS the prior-quarter HIGH while at
//     least one other asset HOLDS below its own prior-quarter high.
//   • BULLISH SMT: the mirror at the prior-quarter LOW.
//   Confirmation (input): Rejection (a sweeping asset closes back inside the
//   prior-quarter range), Quarter Close (final check when the quarter ends),
//   or Both. Only the quarters you enable are evaluated — Q2 (manipulation of
//   Q1's range) and Q4 are on by default.
//
// Label format:  "<cycle> Q<n> <role> ▼/▲"  then each asset with ✓ (swept the
// prior-quarter level) or ✗ (held).  Signals are evaluated on closed bars only.
// REQUESTS: 4 request.security() calls (limit 40).
// - - - - - - - - -

indicator("cephxs / SMT [Quarterly Theory]",
         shorttitle = "cephxs / SMT QT",
         overlay = true,
         max_lines_count = 500,
         max_labels_count = 500)

// - - - - - - - - -
// Input Groups
const string g_sym = "1. 🔗 Correlated Assets"
const string g_cyc = "2. 🧩 Quarterly Cycles"
const string g_det = "3. 🔍 Detection"
const string g_vis = "4. 🎨 Visuals"

// - - - - - - - - -
// Types
type QAsset
    string name
    bool   active
    float  cur_hi
    float  cur_lo
    int    cur_hi_t
    int    cur_lo_t
    float  prev_hi
    float  prev_lo
    int    prev_hi_t
    int    prev_lo_t
    bool   swept_hi = false
    bool   swept_lo = false

type QCycle
    string tag
    bool   enabled
    array<QAsset> assets          // index 0 = chart asset
    int    q        = -1          // current quarter 0..3
    int    qid      = -1          // current quarter id (change = new quarter)
    bool   fired_hi = false
    bool   fired_lo = false
    int    last_t   = 0           // open time of the last processed bar
    int    last_dir = 0           // 1 bullish, -1 bearish
    string last_txt = ""

type SMTDraw
    line  ln
    label lb
    int   x
    bool  isHigh

// - - - - - - - - -
// Inputs — assets
bool   sm1_on = input.bool(true, "", inline = "s1", group = g_sym)
string sm1    = input.symbol("NQ1!", "Asset 1", inline = "s1", group = g_sym)
bool   sm2_on = input.bool(true, "", inline = "s2", group = g_sym)
string sm2    = input.symbol("ES1!", "Asset 2", inline = "s2", group = g_sym)
bool   sm3_on = input.bool(true, "", inline = "s3", group = g_sym)
string sm3    = input.symbol("YM1!", "Asset 3", inline = "s3", group = g_sym)
bool   sm4_on = input.bool(true, "", inline = "s4", group = g_sym, tooltip = "The asset matching the chart symbol is skipped automatically (micros count as their full-size contract).")
string sm4    = input.symbol("RTY1!", "Asset 4", inline = "s4", group = g_sym)

// Inputs — cycles
bool cyc90_on  = input.bool(false, "90-Min cycle (22.5m quarters)", group = g_cyc, tooltip = "Needs a chart timeframe of 15m or lower (5m or lower recommended).")
bool cycD_on   = input.bool(true,  "Daily cycle (6h quarters)", group = g_cyc)
bool cycW_on   = input.bool(false, "Weekly cycle (day quarters)", group = g_cyc)
bool q1_on     = input.bool(false, "Evaluate Q1 (vs previous Q4)", group = g_cyc, tooltip = "Accumulation: the new cycle's first quarter vs the prior cycle's Q4.")
bool q2_on     = input.bool(true,  "Evaluate Q2 (vs Q1) — manipulation", group = g_cyc, tooltip = "Q2 sweeping Q1's range with divergence = classic manipulation before Q3 distribution.")
bool q3_on     = input.bool(false, "Evaluate Q3 (vs Q2) — distribution", group = g_cyc)
bool q4_on     = input.bool(true,  "Evaluate Q4 (vs Q3) — continuation / reversal", group = g_cyc)
string tz      = input.string("America/New_York", "Cycle Timezone", group = g_cyc, tooltip = "Quarter boundaries are anchored to 18:00 in this timezone (futures trading day open).")

// Inputs — detection
string smt_confirm = input.string("Both", "Confirmation", options = ["Rejection", "Quarter Close", "Both"], group = g_det, tooltip = "Rejection: a sweeping asset closes back inside the prior-quarter range (signal at that bar).\nQuarter Close: final check when the quarter ends.\nBoth: rejection first, quarter-close check if nothing fired.")
bool smt_show_hi = input.bool(true, "Bearish SMT (prior-quarter highs)", group = g_det)
bool smt_show_lo = input.bool(true, "Bullish SMT (prior-quarter lows)", group = g_det)

// Inputs — visuals
color q_bear_col = input.color(#db5755, "Bearish", inline = "col", group = g_vis)
color q_bull_col = input.color(#00a2c7, "Bullish", inline = "col", group = g_vis)
int   q_width    = input.int(1, "Line Width", minval = 1, maxval = 4, group = g_vis)
int   q_max_draw = input.int(40, "Max SMT Drawings", minval = 5, maxval = 150, group = g_vis)
string div_sel   = input.string("Daily", "Quarter Dividers", options = ["None", "90-Min", "Daily", "Weekly"], group = g_vis, tooltip = "Draw Q1-Q4 divider lines for one cycle.")
bool  show_tbl   = input.bool(true, "Show Status Table", group = g_vis)

// - - - - - - - - -
// String helpers
nameOf(string s) =>
    int c = str.pos(s, ":")
    na(c) ? s : str.substring(s, c + 1)

rootOf(string s) =>
    string t = nameOf(s)
    int b = str.pos(t, "!")
    na(b) or b < 2 ? t : str.substring(t, 0, b - 1)

normRoot(string r) =>
    r == "MNQ" ? "NQ" : r == "MES" ? "ES" : r == "MYM" ? "YM" : r == "M2K" ? "RTY" : r

qRole(int q) =>
    q == 0 ? "accum" : q == 1 ? "manip" : q == 2 ? "distr" : "cont/rev"

qOn(int q) =>
    q == 0 ? q1_on : q == 1 ? q2_on : q == 2 ? q3_on : q4_on

// - - - - - - - - -
// Resolved assets / cycles
string chartRoot = normRoot(syminfo.root)
bool act1 = sm1_on and normRoot(rootOf(sm1)) != chartRoot
bool act2 = sm2_on and normRoot(rootOf(sm2)) != chartRoot
bool act3 = sm3_on and normRoot(rootOf(sm3)) != chartRoot
bool act4 = sm4_on and normRoot(rootOf(sm4)) != chartRoot

int  tfs      = timeframe.in_seconds()
bool cy90_ok  = cyc90_on and tfs <= 900
bool cyD_ok   = cycD_on and tfs <= 21600
bool cyW_ok   = cycW_on and tfs <= 86400

makeCycle(string tag, bool en) =>
    array<QAsset> arr = array.new<QAsset>()
    array.push(arr, QAsset.new(syminfo.ticker, true))
    array.push(arr, QAsset.new(nameOf(sm1), act1))
    array.push(arr, QAsset.new(nameOf(sm2), act2))
    array.push(arr, QAsset.new(nameOf(sm3), act3))
    array.push(arr, QAsset.new(nameOf(sm4), act4))
    QCycle.new(tag, en, arr)

var QCycle c90 = makeCycle("90m", cy90_ok)
var QCycle cD  = makeCycle("Day", cyD_ok)
var QCycle cW  = makeCycle("Wk",  cyW_ok)

var array<SMTDraw> draws     = array.new<SMTDraw>()
var array<line>    div_lines = array.new<line>()
var array<label>   div_lbls  = array.new<label>()

// - - - - - - - - -
// Quarter clocks (bar open time, anchored 18:00 in tz)

// Seconds elapsed since the 18:00 trading-day open.
secsSinceOpen(int t) =>
    ((hour(t, tz) + 6) % 24) * 3600 + minute(t, tz) * 60 + second(t, tz)

// 90-min quarter id (0..63 per day); quarter within cycle = id % 4.
q90Id(int t) =>
    int(math.floor(secsSinceOpen(t) / 1350.0))

// Daily 6h quarter: Q1 18-00, Q2 00-06, Q3 06-12, Q4 12-18.
qDay(int t) =>
    int h = hour(t, tz)
    h >= 18 ? 0 : int(h / 6) + 1

// Weekly day quarter (trading day = shifted +6h): Mon Q1, Tue Q2, Wed Q3, Thu/Fri Q4.
qWeek(int t) =>
    int d = dayofweek(t + 21600000, tz)
    d == dayofweek.monday ? 0 : d == dayofweek.tuesday ? 1 : d == dayofweek.wednesday ? 2 : 3

int nid90 = q90Id(time)
int nq90  = nid90 % 4
int nqD   = qDay(time)
int nqW   = qWeek(time)

bool chg90 = nid90 != nid90[1]
bool chgD  = nqD != nqD[1]
bool chgW  = nqW != nqW[1]

// - - - - - - - - -
// Drawing helpers

// Level line (prior-quarter extreme -> now) + label; labels on the same bar
// and side are merged so nothing stacks on top of itself.
drawQ(bool isHigh, int x1, float lvl, int x2, float yLbl, string txt) =>
    color col = isHigh ? q_bear_col : q_bull_col
    bool merged = false
    if array.size(draws) > 0
        for i = array.size(draws) - 1 to 0
            SMTDraw d = array.get(draws, i)
            if d.x == x2 and d.isHigh == isHigh and not na(d.lb)
                label.set_text(d.lb, label.get_text(d.lb) + "\n" + txt)
                merged := true
                break
    line ln = line.new(x1, lvl, x2, lvl, xloc = xloc.bar_time, color = col, style = line.style_dotted, width = q_width)
    label lb = na
    if not merged
        lb := label.new(x2, yLbl, txt, xloc = xloc.bar_time, style = isHigh ? label.style_label_down : label.style_label_up, color = color.new(color.white, 100), textcolor = col, size = size.tiny)
    array.push(draws, SMTDraw.new(ln, lb, x2, isHigh))
    while array.size(draws) > q_max_draw
        SMTDraw old = array.shift(draws)
        line.delete(old.ln)
        if not na(old.lb)
            label.delete(old.lb)
    true

drawDivider(int q) =>
    line l = line.new(bar_index, low, bar_index, high, extend = extend.both, color = color.new(color.gray, 70), style = line.style_dotted)
    label lb = label.new(bar_index, high, "Q" + str.tostring(q + 1), yloc = yloc.abovebar, style = label.style_none, textcolor = color.gray, size = size.tiny)
    array.push(div_lines, l)
    array.push(div_lbls, lb)
    while array.size(div_lines) > 80
        line.delete(array.shift(div_lines))
    while array.size(div_lbls) > 80
        label.delete(array.shift(div_lbls))
    true

// - - - - - - - - -
// SMT logic

// Count assets that swept / held the prior-quarter level and build the label list.
sweepSummary(QCycle cy, bool isHigh) =>
    int ns = 0
    int nh = 0
    string txt = ""
    for i = 0 to array.size(cy.assets) - 1
        QAsset a = array.get(cy.assets, i)
        if a.active
            bool sw = isHigh ? a.swept_hi : a.swept_lo
            if sw
                ns += 1
            else
                nh += 1
            txt := txt + (txt == "" ? "" : " ") + a.name + (sw ? "✓" : "✗")
    [ns, nh, txt]

// True if any asset that swept the prior-quarter level has closed back inside.
anyRejected(QCycle cy, bool isHigh, array<float> cs) =>
    bool r = false
    for i = 0 to array.size(cy.assets) - 1
        QAsset a = array.get(cy.assets, i)
        if a.active
            float c = array.get(cs, i)
            if not na(c)
                if isHigh
                    if a.swept_hi and c < a.prev_hi
                        r := true
                else
                    if a.swept_lo and c > a.prev_lo
                        r := true
    r

// Evaluate one side; draws + records the signal. Returns true if SMT fired.
trySignal(QCycle cy, bool isHigh, bool atClose, int t) =>
    bool fired = false
    bool already = isHigh ? cy.fired_hi : cy.fired_lo
    bool sideOn = isHigh ? smt_show_hi : smt_show_lo
    QAsset ch = array.get(cy.assets, 0)
    float lvl = isHigh ? ch.prev_hi : ch.prev_lo
    int   t1  = isHigh ? ch.prev_hi_t : ch.prev_lo_t
    if sideOn and not already and not na(lvl) and not na(t1)
        [ns, nh, txt] = sweepSummary(cy, isHigh)
        if ns > 0 and nh > 0
            float yLbl = isHigh ? ch.cur_hi : ch.cur_lo
            string head = cy.tag + " Q" + str.tostring(cy.q + 1) + " " + qRole(cy.q) + (isHigh ? " ▼" : " ▲") + (atClose ? " (close)" : "")
            drawQ(isHigh, t1, lvl, t, yLbl, head + "\n" + txt)
            if isHigh
                cy.fired_hi := true
            else
                cy.fired_lo := true
            cy.last_dir := isHigh ? -1 : 1
            cy.last_txt := "Q" + str.tostring(cy.q + 1) + (isHigh ? " ▼ " : " ▲ ") + txt
            fired := true
    fired

// Per-bar cycle update. Returns [bearishSMT, bullishSMT] flags.
processCycle(QCycle cy, int nid, int nq, array<float> hs, array<float> ls, array<float> cs, int t) =>
    bool bearF = false
    bool bullF = false
    bool newQ = nid != cy.qid

    if newQ
        // Final check for the quarter that just ended (before references roll).
        if cy.qid != -1 and qOn(cy.q) and smt_confirm != "Rejection"
            if trySignal(cy, true, true, cy.last_t)
                bearF := true
            if trySignal(cy, false, true, cy.last_t)
                bullF := true
        // Roll: current extremes become the prior-quarter reference levels.
        for i = 0 to array.size(cy.assets) - 1
            QAsset a = array.get(cy.assets, i)
            a.prev_hi   := a.cur_hi
            a.prev_lo   := a.cur_lo
            a.prev_hi_t := a.cur_hi_t
            a.prev_lo_t := a.cur_lo_t
            a.cur_hi    := array.get(hs, i)
            a.cur_lo    := array.get(ls, i)
            a.cur_hi_t  := t
            a.cur_lo_t  := t
            a.swept_hi  := false
            a.swept_lo  := false
        cy.q := nq
        cy.qid := nid
        cy.fired_hi := false
        cy.fired_lo := false
    else
        for i = 0 to array.size(cy.assets) - 1
            QAsset a = array.get(cy.assets, i)
            float h = array.get(hs, i)
            float l = array.get(ls, i)
            if not na(h)
                if na(a.cur_hi) or h > a.cur_hi
                    a.cur_hi := h
                    a.cur_hi_t := t
            if not na(l)
                if na(a.cur_lo) or l < a.cur_lo
                    a.cur_lo := l
                    a.cur_lo_t := t

    // Sweep flags: did the current quarter trade beyond the prior quarter's extreme?
    for i = 0 to array.size(cy.assets) - 1
        QAsset a = array.get(cy.assets, i)
        if not na(a.prev_hi) and not na(a.cur_hi) and a.cur_hi > a.prev_hi
            a.swept_hi := true
        if not na(a.prev_lo) and not na(a.cur_lo) and a.cur_lo < a.prev_lo
            a.swept_lo := true

    // Rejection confirmation (sweep, then a close back inside the prior range).
    if qOn(cy.q) and smt_confirm != "Quarter Close"
        if not cy.fired_hi and anyRejected(cy, true, cs)
            if trySignal(cy, true, false, t)
                bearF := true
        if not cy.fired_lo and anyRejected(cy, false, cs)
            if trySignal(cy, false, false, t)
                bullF := true

    cy.last_t := t
    [bearF, bullF]

// OHLC feed for a correlated asset on the chart timeframe.
fetchHLC(string sym) =>
    request.security(sym, timeframe.period, [high, low, close], barmerge.gaps_off, barmerge.lookahead_off)

// - - - - - - - - -
// Data requests (inactive slots request the chart symbol; never used)
[a1_h, a1_l, a1_c] = fetchHLC(act1 ? sm1 : syminfo.tickerid)
[a2_h, a2_l, a2_c] = fetchHLC(act2 ? sm2 : syminfo.tickerid)
[a3_h, a3_l, a3_c] = fetchHLC(act3 ? sm3 : syminfo.tickerid)
[a4_h, a4_l, a4_c] = fetchHLC(act4 ? sm4 : syminfo.tickerid)

// - - - - - - - - -
// Main
bool engine_on  = barstate.isconfirmed
bool newBearSMT = false
bool newBullSMT = false

if engine_on
    array<float> hs = array.from(high, a1_h, a2_h, a3_h, a4_h)
    array<float> ls = array.from(low,  a1_l, a2_l, a3_l, a4_l)
    array<float> cs = array.from(close, a1_c, a2_c, a3_c, a4_c)

    if cy90_ok
        [b90, u90] = processCycle(c90, nid90, nq90, hs, ls, cs, time)
        newBearSMT := newBearSMT or b90
        newBullSMT := newBullSMT or u90
    if cyD_ok
        [bD, uD] = processCycle(cD, nqD, nqD, hs, ls, cs, time)
        newBearSMT := newBearSMT or bD
        newBullSMT := newBullSMT or uD
    if cyW_ok
        [bW, uW] = processCycle(cW, nqW, nqW, hs, ls, cs, time)
        newBearSMT := newBearSMT or bW
        newBullSMT := newBullSMT or uW

    // Quarter dividers for the selected cycle.
    if div_sel == "90-Min" and cy90_ok and chg90
        drawDivider(nq90)
    if div_sel == "Daily" and cyD_ok and chgD
        drawDivider(nqD)
    if div_sel == "Weekly" and cyW_ok and chgW
        drawDivider(nqW)

// - - - - - - - - -
// Alerts
alertcondition(newBullSMT, "Bullish Quarterly SMT", "Bullish quarterly SMT on {{ticker}} ({{interval}})")
alertcondition(newBearSMT, "Bearish Quarterly SMT", "Bearish quarterly SMT on {{ticker}} ({{interval}})")
alertcondition(newBullSMT or newBearSMT, "Any Quarterly SMT", "Quarterly SMT on {{ticker}} ({{interval}})")

// - - - - - - - - -
// Status table
var table tbl = table.new(position.bottom_right, 3, 5, border_width = 1)
if show_tbl and barstate.islast
    color bg = color.new(color.black, 80)
    table.cell(tbl, 0, 0, "Cycle", text_color = color.white, bgcolor = bg, text_size = size.small)
    table.cell(tbl, 1, 0, "Now", text_color = color.white, bgcolor = bg, text_size = size.small)
    table.cell(tbl, 2, 0, "Last SMT", text_color = color.white, bgcolor = bg, text_size = size.small)
    array<QCycle> cys = array.from(c90, cD, cW)
    for i = 0 to 2
        QCycle cy = array.get(cys, i)
        bool ok = i == 0 ? cy90_ok : i == 1 ? cyD_ok : cyW_ok
        string nowTxt = not ok or cy.q < 0 ? "—" : "Q" + str.tostring(cy.q + 1) + " " + qRole(cy.q)
        string sigTxt = not ok ? "off" : cy.last_dir == 0 ? "—" : cy.last_txt
        color tcol = not ok or cy.last_dir == 0 ? color.gray : cy.last_dir > 0 ? q_bull_col : q_bear_col
        table.cell(tbl, 0, i + 1, cy.tag, text_color = color.white, bgcolor = bg, text_size = size.small)
        table.cell(tbl, 1, i + 1, nowTxt, text_color = color.white, bgcolor = bg, text_size = size.small)
        table.cell(tbl, 2, i + 1, sigTxt, text_color = tcol, bgcolor = bg, text_size = size.small)
    string cmp = (act1 ? nameOf(sm1) + " " : "") + (act2 ? nameOf(sm2) + " " : "") + (act3 ? nameOf(sm3) + " " : "") + (act4 ? nameOf(sm4) : "")
    table.cell(tbl, 0, 4, "vs", text_color = color.white, bgcolor = bg, text_size = size.small)
    table.cell(tbl, 1, 4, cmp, text_color = color.white, bgcolor = bg, text_size = size.small)
    table.cell(tbl, 2, 4, "", bgcolor = bg, text_size = size.small)
