f_row_state_comb(SMTState s1, SMTState s2, bool is_valid) =>

    string st_txt  = "◌ ᴏꜰꜰ"

    string age_txt = "─"

    string act_txt = "─"

    color  st_col  = d_dim_c

    if is_valid

        int tot_bull = s1.act_bull + (is_tri ? s2.act_bull : 0)

        int tot_bear = s1.act_bear + (is_tri ? s2.act_bear : 0)

        act_txt := str.tostring(tot_bull) + "▲  " + str.tostring(tot_bear) + "▼"



        bool b_live = s1.bull_live or (is_tri and s2.bull_live)

        bool r_live = s1.bear_live or (is_tri and s2.bear_live)



        if b_live or r_live

            st_txt  := b_live ? "⚡ ʟɪᴠᴇ ▲" : "⚡ ʟɪᴠᴇ ▼"

            age_txt := "◉ ɴᴏᴡ"

            st_col  := b_live ? bull_col : bear_col

        else

            int b1 = nz(s1.last_bar, -1)

            int b2 = is_tri ? nz(s2.last_bar, -1) : -1

            int best_b = math.max(b1, b2)

            int best_d = best_b == b1 ? s1.last_dir : s2.last_dir

            if best_d != 0 and best_b >= 0

                st_txt  := best_d == 1 ? "▲ ʙᴜʟʟ" : "▼ ʙᴇᴀʀ"

                int b_ago = math.max(0, bar_index - best_b)

                age_txt := b_ago == 0 ? "◉ ɴᴏᴡ" : (str.tostring(b_ago) + "ʙ ᴀɢᴏ")

                st_col  := best_d == 1 ? bull_col : bear_col

            else

                st_txt  := "◌ ꜱᴄᴀɴ"

                age_txt := "─"

                st_col  := d_dim_c

    [st_txt, age_txt, act_txt, st_col]



