    float win_hi = ta.highest(src_h, w)

    float win_lo = ta.lowest(src_l, w)

    float ph = (not na(ph_raw) and (ph_raw - win_lo) >= min_swing * atr_v) ? ph_raw : na

    float pl = (not na(pl_raw) and (win_hi - pl_raw) >= min_swing * atr_v) ? pl_raw : na

    int t_open   = time[pivot_len + sh]

    int t_close  = time_close[pivot_len + sh]

    float pc_o   = open[pivot_len + sh]

    float pc_c   = close[pivot_len + sh]

    [high, low, open, close, ph, pl, t_open, t_close, win_hi, win_lo, atr_v, pc_o, pc_c]



