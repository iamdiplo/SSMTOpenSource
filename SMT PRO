f_process_cisd_from_smt(bool allow_cisd, string tf_tag, string p_name, bool is_bull, int piv_b, float ext_price, float smt_inv_lvl, color col) =>

    if show_cisd and allow_cisd and not na(piv_b) and piv_b <= bar_index

        int look_bars = bar_index - piv_b

        [cur_ob, cur_lvl] = f_find_cisd_origin(piv_b, is_bull)

        bool trig     = false

        bool violated = false

        int  trig_b   = na



        if look_bars > 0

            int max_step = math.min(look_bars, cisd_expiry)

            for step = 1 to max_step

                int b_idx = piv_b + step

                int off   = bar_index - b_idx

                if off >= 0 and off <= math.min(bar_index, 1200)

                    if (is_bull and low[off] < ext_price) or (not is_bull and high[off] > ext_price)

                        violated := true

                        break

                    bool broke = is_bull ? (close[off] > cur_lvl) : (close[off] < cur_lvl)

                    if broke

                        trig   := true

                        trig_b := b_idx

                        break



        if not violated and trig and not na(trig_b)

            bool dup_cisd = (cisd_st.last_conf_ob == cur_ob and cisd_st.last_conf_tb == trig_b)

            if not dup_cisd

                line   c_ln  = line.new(cur_ob, cur_lvl, trig_b, cur_lvl, xloc=xloc.bar_index, color=col, width=2, style=line.style_solid)

