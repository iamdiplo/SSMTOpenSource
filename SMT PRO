                string c_tip = "⚡ SMT/PSP PRO • CONFIRMED CISD ✓\n────────────────────────\n◈ Source SMT: " + tf_tag + " (" + main_name + " ⇄ " + p_name + ")\n◈ CISD Level: " + str.tostring(cur_lvl, format.mintick)

                color  c_bg  = is_pill ? color.new(#131722, 18) : color.new(col, 100)

                label  c_lb  = label.new(trig_b, cur_lvl, c_txt, xloc=xloc.bar_index, color=c_bg, textcolor=col, style=is_bull ? label.style_label_down : label.style_label_up, size=lbl_size_base, tooltip=c_tip)

                f_store_cisd(c_ln, c_lb, is_bull, piv_b, smt_inv_lvl, col)

                cisd_st.last_conf_ob := cur_ob

                cisd_st.last_conf_tb := trig_b

                cisd_st.triggered    := true

                cisd_st.just_conf    := true

                cisd_st.is_bull      := is_bull

                cisd_st.level        := cur_lvl

                cisd_st.tf_tag       := tf_tag

                if cisd_st.active and cisd_st.smt_bar <= piv_b

                    line.delete(cisd_st.ln)

                    label.delete(cisd_st.lb)

                    cisd_st.active := false

        else if not violated and look_bars <= cisd_expiry

            if cisd_st.active

                line.delete(cisd_st.ln)

                label.delete(cisd_st.lb)

            cisd_st.active      := true

            cisd_st.triggered   := false

            cisd_st.is_bull     := is_bull

            cisd_st.level       := cur_lvl

            cisd_st.ext_lvl     := ext_price

            cisd_st.smt_inv_lvl := smt_inv_lvl

            cisd_st.orig_bar    := cur_ob

            cisd_st.smt_bar     := piv_b

            cisd_st.tf_tag      := tf_tag

            cisd_st.base_col    := col

            string p_txt        = is_min ? ("◌ ᴄɪꜱᴅ ❲" + tf_tag + "❳") : is_pill ? ("◌ ᴄɪꜱᴅ • " + tf_tag) : ("◌ ᴘᴇɴᴅɪɴɢ " + tf_tag + " ᴄɪꜱᴅ")

            string p_tip        = "⚡ SMT/PSP PRO • PENDING CISD\n────────────────────────\n◈ Source SMT: " + tf_tag + " (" + main_name + " ⇄ " + p_name + ")\n◈ Target Close: " + str.tostring(cur_lvl, format.mintick)

            color  p_bg         = is_pill ? color.new(#131722, 22) : color.new(col, 100)

            cisd_st.ln          := line.new(cur_ob, cur_lvl, bar_index, cur_lvl, xloc=xloc.bar_index, color=col, width=1, style=line.style_dashed)

            cisd_st.lb          := label.new(bar_index, cur_lvl, p_txt, xloc=xloc.bar_index, color=p_bg, textcolor=col, style=is_bull ? label.style_label_down : label.style_label_up, size=lbl_size_base, tooltip=p_tip)

    true



f_mark_smt_broken(HistoricalSMT item) =>

    item.broken := true

    line.set_style(item.ln, line.style_dotted)

    line.set_color(item.ln, color.new(item.base_col, 80))

    label.set_textcolor(item.lb, color.new(item.base_col, 78))

    label.set_text(item.lb, item.base_txt + " ✕")

    label.set_tooltip(item.lb, str.replace_all(item.base_tip, "✓ ACTIVE / VALID", "✕ BROKEN / MITIGATED"))

    if not is_min

        label.set_color(item.lb, color.new(#131722, 88))

    true



f_store_smt(SMTState st, line ln, label lb, bool is_bull, float inv_lvl, int start_bar, int end_bar, color col, string base_txt, string base_tip, bool pre_broken) =>

    HistoricalSMT rec = HistoricalSMT.new(ln, lb, is_bull, inv_lvl, start_bar, end_bar, col, base_txt, base_tip, pre_broken)

    if pre_broken

        f_mark_smt_broken(rec)

    array.push(st.records, rec)

    if array.size(st.records) > max_active

        HistoricalSMT old = array.shift(st.records)

        line.delete(old.ln)

        label.delete(old.lb)

    true



f_check_invalidations(SMTState st) =>

    int u_cnt = 0

    int b_cnt = 0

    if array.size(st.records) > 0

        float upper_chk = inv_trig == "Wick Break" ? high : math.max(open, close)

        float lower_chk = inv_trig == "Wick Break" ? low  : math.min(open, close)

        for i = array.size(st.records) - 1 to 0

            HistoricalSMT item = array.get(st.records, i)

            if not item.broken and bar_index > item.end_bar + pivot_len and inv_action != "Keep All"

                bool is_broken = item.is_bull ? (lower_chk < item.inv_lvl) : (upper_chk > item.inv_lvl)

                if is_broken

                    if item.is_bull

                        st.brk_bull := true

                    else

                        st.brk_bear := true

                    if inv_action == "Delete"

                        line.delete(item.ln)

                        label.delete(item.lb)

                        array.remove(st.records, i)

                        continue

                    else

                        f_mark_smt_broken(item)

            if not item.broken

                if item.is_bull

                    u_cnt += 1

                else

                    b_cnt += 1

    st.act_bull := u_cnt

    st.act_bear := b_cnt

    true



f_push_cap(SwP[] a, SwP p) =>

    array.push(a, p)

    if array.size(a) > 60

        array.shift(a)

    true



f_sweep_main(SwP[] a, float v, float comp_v, float tol_m, float tol_c, bool is_bull, bool inv) =>

    SwP best_smt = na

    while array.size(a) > 0

        SwP t = array.last(a)

        bool swept = is_bull ? (v < t.mp - tol_m) : (v > t.mp + tol_m)

        if swept

            SwP popped = array.pop(a)

            bool comp_also_swept = is_bull ? f_out_l(comp_v, popped.cp, tol_c, inv) : f_out_h(comp_v, popped.cp, tol_c, inv)

            if not comp_also_swept

                best_smt := popped

        else

            break

    best_smt



f_find_unmit_main_smt(SwP[] a, float v, float comp_v, float tol_m, float tol_c, bool is_bull, bool inv) =>

    SwP res = na

    int sz = array.size(a)

    if sz > 0

        for i = sz - 1 to math.max(0, sz - 8)

            SwP t = array.get(a, i)

            bool main_swept = is_bull ? (v < t.mp - tol_m) : (v > t.mp + tol_m)

            bool comp_swept = is_bull ? f_out_l(comp_v, t.cp, tol_c, inv) : f_out_h(comp_v, t.cp, tol_c, inv)

            if not main_swept and comp_swept

                res := t

                break

    res



f_sweep_comp(SwP[] a, float v, float main_v, float tol_c, float tol_m, bool is_bull, bool inv) =>

    SwP best_smt = na

    while array.size(a) > 0

        SwP t = array.last(a)

        bool swept = is_bull ? f_out_l(v, t.cp, tol_c, inv) : f_out_h(v, t.cp, tol_c, inv)

        if swept

            SwP popped = array.pop(a)

            bool main_also_swept = is_bull ? (main_v < popped.mp - tol_m) : (main_v > popped.mp + tol_m)

            if not main_also_swept

                best_smt := popped

        else

            break

    best_smt



f_try_merge_triad_smt(SMTState primary_st, bool is_bull, int x1, float y1, int x2, float y2, string tf_tag, string p2_name, bool inv2, string eng_code) =>

    bool merged = false

    if is_tri and lbl_merge_tri and array.size(primary_st.records) > 0

        HistoricalSMT last_rec = array.last(primary_st.records)

        if last_rec.is_bull == is_bull and last_rec.start_bar == x1 and last_rec.end_bar == x2

            string dual_pair  = pair_name1 + "+" + p2_name

            string base_d_txt = f_format_label(tf_tag, dual_pair, is_bull, false, eng_code, true, false)

            string m_txt      = last_rec.broken ? (base_d_txt + " ✕") : base_d_txt

            string m_tip      = f_build_smt_tooltip(tf_tag, dual_pair + " (★ Dual Triad Confirmed)", inv2, is_bull, false, eng_code, x1, y1, x2, y2, last_rec.inv_lvl, last_rec.broken)

            last_rec.base_txt := base_d_txt

            last_rec.base_tip := m_tip

            label.set_text(last_rec.lb, m_txt)

            label.set_tooltip(last_rec.lb, m_tip)

            merged := true

    merged



f_emit_smt(SMTState st, SMTState primary_st, bool allow_cisd, string tf_tag, string p_name, bool inv, string pos_mode, bool is_bull, int x1, float y1, int x2, float y2, color col, int width, string eng_code, float tol_m) =>

    bool drawn = false

    int dist = x2 - x1

    bool dup = is_bull ? (st.ls_bull_x1 == x1 and st.ls_bull_x2 == x2) : (st.ls_bear_x1 == x1 and st.ls_bear_x2 == x2)

    bool path_ok = f_is_clean_path(x1, y1, x2, y2, is_bull, tol_m)

    if dist >= min_len and dist <= max_len and not dup and path_ok

        float inv_lvl = is_bull ? math.min(y1, y2) : math.max(y1, y2)

        bool already_broken = false

        int check_start_bar = x2 + pivot_len

        if inv_action != "Keep All" and bar_index > check_start_bar

            int max_k = math.min(bar_index - check_start_bar - 1, math.min(bar_index, 600))

            if max_k >= 0

                for k = 0 to max_k

                    float chk = is_bull ? (inv_trig == "Wick Break" ? low[k] : math.min(open[k], close[k])) : (inv_trig == "Wick Break" ? high[k] : math.max(open[k], close[k]))

                    bool brk = is_bull ? (chk < inv_lvl) : (chk > inv_lvl)

                    if brk

                        already_broken := true

                        break



        if not (already_broken and inv_action == "Delete")

            bool was_merged = false

            if st.pair_slot == 1

                was_merged := f_try_merge_triad_smt(primary_st, is_bull, x1, y1, x2, y2, tf_tag, p_name, inv, eng_code)

            if not was_merged

                line   ln       = line.new(x1, y1, x2, y2, xloc=xloc.bar_index, color=col, width=width, style=line.style_solid)

                string base_txt = f_format_label(tf_tag, p_name, is_bull, false, eng_code, false, false)

                string base_tip = f_build_smt_tooltip(tf_tag, p_name, inv, is_bull, false, eng_code, x1, y1, x2, y2, inv_lvl, false)

                label  lb       = f_create_smt_label(x1, y1, x2, y2, base_txt, base_tip, col, is_bull, false, pos_mode, st.tf_rank, st.pair_slot)

                f_store_smt(st, ln, lb, is_bull, inv_lvl, x1, x2, col, base_txt, base_tip, already_broken and inv_action == "Fade (Ghost)")

            drawn := true

            if is_bull

                st.ls_bull_x1 := x1

                st.ls_bull_x2 := x2

                st.new_bull   := true

                if not already_broken

                    st.last_dir := 1

                    st.last_bar := x2

            else

                st.ls_bear_x1 := x1

                st.ls_bear_x2 := x2

                st.new_bear   := true

                if not already_broken

                    st.last_dir := -1

                    st.last_bar := x2

            if not already_broken

                f_process_cisd_from_smt(allow_cisd, tf_tag, p_name, is_bull, x2, y2, inv_lvl, is_bull ? bull_col : bear_col)

    drawn



f_process_smt(SMTState st, SMTState primary_st, bool enabled, bool is_htf, bool allow_cisd, string tf_tag, string p_name, bool inv, string pos_mode, float m_ph, float m_pl, int m_to, int m_tc, float m_atr, float m_po, float m_pc, float c_ph, float c_pl, int c_to, int c_tc, float c_wh, float c_wl, float c_atr, float c_h_now, float c_l_now, color b_col, color u_col, int width) =>

    line.delete(st.live_b_ln)

    label.delete(st.live_b_lb)

    line.delete(st.live_u_ln)

    label.delete(st.live_u_lb)

    st.bear_live := false

    st.bull_live := false

    st.new_bear  := false

    st.new_bull  := false

    st.brk_bear  := false

    st.brk_bull  := false



    if enabled

        bool use_classic = sens_mode != "Medium"

        bool use_stack   = sens_mode != "Low"



        float comp_piv_h  = inv ? c_wl : c_wh

        float comp_piv_l  = inv ? c_wh : c_wl

        float comp_curr_h = inv ? c_l_now : c_h_now

        float comp_curr_l = inv ? c_h_now : c_l_now

        float tol_m = nz(eq_tol * m_atr)

        float tol_c = nz(eq_tol * c_atr)



        // 1. Main Pivot High (Bearish SMT)

        if not na(m_ph) and (na(st.last_ph_to) or m_to != st.last_ph_to)

            int   curr_b = bar_index - pivot_len

            float curr_m = m_ph

            bool  pos_ok = true

            if is_htf

                [b_idx, b_val, fnd] = f_find_exact_wick_bar(m_to, m_tc, true)

                curr_b := b_idx

                curr_m := b_val

                pos_ok := fnd



            if pos_ok

                bool candle_ok = not candle_chk or (m_pc < m_po)

                bool emitted_h = false



                if use_classic and show_conf and candle_ok and not na(st.prev_ph_m)

                    bool main_out = curr_m > st.prev_ph_m + tol_m

                    bool comp_out = f_out_h(comp_piv_h, st.prev_ph_c, tol_c, inv)

                    if main_out != comp_out

                        emitted_h := f_emit_smt(st, primary_st, allow_cisd, tf_tag, p_name, inv, pos_mode, false, st.prev_ph_b, st.prev_ph_m, curr_b, curr_m, b_col, width, "CLS", tol_m)



                if use_stack

                    SwP s1 = f_sweep_main(st.ms_bear, curr_m, comp_piv_h, tol_m, tol_c, false, inv)

                    if not na(s1) and show_conf and candle_ok and not emitted_h

                        emitted_h := f_emit_smt(st, primary_st, allow_cisd, tf_tag, p_name, inv, pos_mode, false, s1.bar, s1.mp, curr_b, curr_m, b_col, width, "MSW", tol_m)

                    if not emitted_h and show_conf and candle_ok

                        SwP s1_lh = f_find_unmit_main_smt(st.ms_bear, curr_m, comp_piv_h, tol_m, tol_c, false, inv)

                        if not na(s1_lh)

                            emitted_h := f_emit_smt(st, primary_st, allow_cisd, tf_tag, p_name, inv, pos_mode, false, s1_lh.bar, s1_lh.mp, curr_b, curr_m, b_col, width, "FLS", tol_m)

                    f_push_cap(st.ms_bear, SwP.new(curr_b, curr_m, comp_piv_h))



                st.prev_ph_m := curr_m

                st.prev_ph_c := comp_piv_h

                st.prev_ph_b := curr_b

            else

                st.prev_ph_m := na

                st.prev_ph_c := na

                st.prev_ph_b := na



            st.last_ph_to := m_to

            st.ph_mit     := false



        // 2. Main Pivot Low (Bullish SMT)

        if not na(m_pl) and (na(st.last_pl_to) or m_to != st.last_pl_to)

            int   curr_b = bar_index - pivot_len

            float curr_m = m_pl

            bool  pos_ok = true

            if is_htf

                [b_idx, b_val, fnd] = f_find_exact_wick_bar(m_to, m_tc, false)

                curr_b := b_idx

                curr_m := b_val

                pos_ok := fnd



            if pos_ok

                bool candle_ok = not candle_chk or (m_pc > m_po)

                bool emitted_l = false



                if use_classic and show_conf and candle_ok and not na(st.prev_pl_m)

                    bool main_out = curr_m < st.prev_pl_m - tol_m

                    bool comp_out = f_out_l(comp_piv_l, st.prev_pl_c, tol_c, inv)

                    if main_out != comp_out

                        emitted_l := f_emit_smt(st, primary_st, allow_cisd, tf_tag, p_name, inv, pos_mode, true, st.prev_pl_b, st.prev_pl_m, curr_b, curr_m, u_col, width, "CLS", tol_m)



                if use_stack

                    SwP s1 = f_sweep_main(st.ms_bull, curr_m, comp_piv_l, tol_m, tol_c, true, inv)

                    if not na(s1) and show_conf and candle_ok and not emitted_l

                        emitted_l := f_emit_smt(st, primary_st, allow_cisd, tf_tag, p_name, inv, pos_mode, true, s1.bar, s1.mp, curr_b, curr_m, u_col, width, "MSW", tol_m)

                    if not emitted_l and show_conf and candle_ok

                        SwP s1_hl = f_find_unmit_main_smt(st.ms_bull, curr_m, comp_piv_l, tol_m, tol_c, true, inv)

                        if not na(s1_hl)

                            emitted_l := f_emit_smt(st, primary_st, allow_cisd, tf_tag, p_name, inv, pos_mode, true, s1_hl.bar, s1_hl.mp, curr_b, curr_m, u_col, width, "FLS", tol_m)

                    f_push_cap(st.ms_bull, SwP.new(curr_b, curr_m, comp_piv_l))



                st.prev_pl_m := curr_m

                st.prev_pl_c := comp_piv_l

                st.prev_pl_b := curr_b

            else

                st.prev_pl_m := na

                st.prev_pl_c := na

                st.prev_pl_b := na



            st.last_pl_to := m_to

            st.pl_mit     := false



        // 2b. Comparison-Driven Sweep-Stack

        if use_stack

            float cv_b = inv ? c_pl : c_ph

            if not na(cv_b) and (na(st.last_cb_to) or c_to != st.last_cb_to)

                int   mb = bar_index - pivot_len

                float mv = high[pivot_len]

                bool  cb_ok = true

                if is_htf

                    [cb_idx, cb_val, cb_fnd] = f_find_exact_wick_bar(c_to, c_tc, true)

                    mb := cb_idx

                    mv := cb_val

                    cb_ok := cb_fnd

                else

                    [loc_b, loc_v] = f_find_local_ext(bar_index - pivot_len, math.min(3, pivot_len), true)

                    mb := loc_b

                    mv := loc_v

                if cb_ok

                    SwP s2 = f_sweep_comp(st.cs_bear, cv_b, mv, tol_c, tol_m, false, inv)

                    if not na(s2) and show_conf

                        bool c_ok2 = not candle_chk or (m_pc < m_po)

                        if c_ok2

                            f_emit_smt(st, primary_st, allow_cisd, tf_tag, p_name, inv, pos_mode, false, s2.bar, s2.mp, mb, mv, b_col, width, "CSW", tol_m)

                    f_push_cap(st.cs_bear, SwP.new(mb, mv, cv_b))

                st.last_cb_to := c_to



            float cv_u = inv ? c_ph : c_pl

            if not na(cv_u) and (na(st.last_cu_to) or c_to != st.last_cu_to)

                int   mb2 = bar_index - pivot_len

                float mv2 = low[pivot_len]

                bool  cu_ok = true

                if is_htf

                    [cu_idx, cu_val, cu_fnd] = f_find_exact_wick_bar(c_to, c_tc, false)

                    mb2 := cu_idx

                    mv2 := cu_val

                    cu_ok := cu_fnd

                else

                    [loc_b2, loc_v2] = f_find_local_ext(bar_index - pivot_len, math.min(3, pivot_len), false)

                    mb2 := loc_b2

                    mv2 := loc_v2

                if cu_ok

                    SwP s3 = f_sweep_comp(st.cs_bull, cv_u, mv2, tol_c, tol_m, true, inv)

                    if not na(s3) and show_conf

                        bool c_ok3 = not candle_chk or (m_pc > m_po)

                        if c_ok3

                            f_emit_smt(st, primary_st, allow_cisd, tf_tag, p_name, inv, pos_mode, true, s3.bar, s3.mp, mb2, mv2, u_col, width, "CSW", tol_m)

                    f_push_cap(st.cs_bull, SwP.new(mb2, mv2, cv_u))

                st.last_cu_to := c_to



        // 3. Check & Clean Invalidated Historical SMTs

        f_check_invalidations(st)



        // 4. Zero-Lag Live Sweep Engine

        if show_live

            if not na(st.prev_ph_m) and (not only_unmit or not st.ph_mit)

                int dist_h = bar_index - st.prev_ph_b

                if dist_h >= min_len and dist_h <= max_len

                    bool m_swept_h = high > st.prev_ph_m + tol_m

                    bool c_swept_h = f_out_h(comp_curr_h, st.prev_ph_c, tol_c, inv)

                    if m_swept_h != c_swept_h

                        st.bear_live := true

                        if barstate.islast

                            string l_eng = m_swept_h ? "MSW" : "CSW"

                            string txt   = f_format_label(tf_tag, p_name, false, true, l_eng, false, false)

                            string tip   = f_build_smt_tooltip(tf_tag, p_name, inv, false, true, "LIV", st.prev_ph_b, st.prev_ph_m, bar_index, high, math.max(st.prev_ph_m, high), false)

                            st.live_b_ln := line.new(st.prev_ph_b, st.prev_ph_m, bar_index, high, xloc=xloc.bar_index, color=b_col, width=width, style=line.style_dashed)

                            st.live_b_lb := f_create_smt_label(st.prev_ph_b, st.prev_ph_m, bar_index, high, txt, tip, b_col, false, true, pos_mode, st.tf_rank, st.pair_slot)



            if not na(st.prev_pl_m) and (not only_unmit or not st.pl_mit)

                int dist_l = bar_index - st.prev_pl_b

                if dist_l >= min_len and dist_l <= max_len

                    bool m_swept_l = low < st.prev_pl_m - tol_m

                    bool c_swept_l = f_out_l(comp_curr_l, st.prev_pl_c, tol_c, inv)

                    if m_swept_l != c_swept_l

                        st.bull_live := true

                        if barstate.islast

                            string l_eng = m_swept_l ? "MSW" : "CSW"

                            string txt   = f_format_label(tf_tag, p_name, true, true, l_eng, false, false)

                            string tip   = f_build_smt_tooltip(tf_tag, p_name, inv, true, true, "LIV", st.prev_pl_b, st.prev_pl_m, bar_index, low, math.min(st.prev_pl_m, low), false)

                            st.live_u_ln := line.new(st.prev_pl_b, st.prev_pl_m, bar_index, low, xloc=xloc.bar_index, color=u_col, width=width, style=line.style_dashed)

                            st.live_u_lb := f_create_smt_label(st.prev_pl_b, st.prev_pl_m, bar_index, low, txt, tip, u_col, true, true, pos_mode, st.tf_rank, st.pair_slot)



        if barstate.isconfirmed

            if not na(st.prev_ph_m) and (high > st.prev_ph_m + tol_m and f_out_h(comp_curr_h, st.prev_ph_c, tol_c, inv))

                st.ph_mit := true

            if not na(st.prev_pl_m) and (low < st.prev_pl_m - tol_m and f_out_l(comp_curr_l, st.prev_pl_c, tol_c, inv))

                st.pl_mit := true

    true



bool cisd_on_ctf  = cisd_src_opt == "All TFs (LTF + HTFs)"

