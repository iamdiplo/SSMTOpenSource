f_find_exact_wick_bar(int t_open, int t_close, bool is_high) =>

    int best_bar = bar_index

    float best_val = is_high ? -1e10 : 1e10

    bool found = false

    int max_back = math.min(bar_index, 600)

    for i = 0 to max_back

        int bt = time[i]

        if na(bt) or bt < t_open

            break

        if bt < t_close

            float v = is_high ? high[i] : low[i]

            if (is_high and v >= best_val) or (not is_high and v <= best_val)

                best_val := v

                best_bar := bar_index - i

                found := true

    [best_bar, best_val, found]



f_find_local_ext(int center_b, int radius, bool is_high) =>

    int best_b = center_b

    int c_off  = math.max(0, math.min(bar_index, bar_index - center_b))

    int s_off  = math.max(0, c_off - radius)

    int e_off  = math.min(math.min(bar_index, 600), c_off + radius)

    float best_v = is_high ? high[c_off] : low[c_off]

    for i = s_off to e_off

        float v = is_high ? high[i] : low[i]

        if (is_high and v >= best_v) or (not is_high and v <= best_v)

            best_v := v

            best_b := bar_index - i

    [best_b, best_v]



f_is_clean_path(int x1, float y1, int x2, float y2, bool is_bull, float tol) =>

    bool clean = true

    int span = x2 - x1

    if span > 1

        float ext_bound = is_bull ? (math.min(y1, y2) - tol) : (math.max(y1, y2) + tol)

        int start_off = math.max(0, bar_index - x2 + 1)

        int end_off   = math.min(math.min(bar_index, 1200), bar_index - x1 - 1)

        if end_off >= start_off

            for i = start_off to end_off

                int cur_x = bar_index - i

                float ratio = float(cur_x - x1) / float(span)

                float line_y = y1 + (y2 - y1) * ratio

                if clean_path

                    if (is_bull and low[i] < ext_bound) or (not is_bull and high[i] > ext_bound)

                        clean := false

                        break

                float body_ext = is_bull ? math.min(open[i], close[i]) : math.max(open[i], close[i])

                if (is_bull and body_ext < line_y - tol) or (not is_bull and body_ext > line_y + tol)

                    clean := false

                    break

    clean



f_find_cisd_origin(int pivot_b, bool is_bull_cisd) =>

    int offset = math.max(0, math.min(bar_index, bar_index - pivot_b))

    int seq_start = offset

    bool seq_found = false

    int max_scan = math.min(offset + 25, math.min(bar_index, 1200))

    for i = offset to max_scan

        bool is_opp_candle = is_bull_cisd ? (close[i] < open[i]) : (close[i] > open[i])

        bool is_doji       = close[i] == open[i]

        if is_opp_candle

            seq_start := i

            seq_found := true

        else if is_doji and seq_found

            continue

        else

            if seq_found or i >= offset + 3

                break

    float cisd_p = seq_found ? open[seq_start] : (is_bull_cisd ? math.max(open[offset], close[offset]) : math.min(open[offset], close[offset]))

    int   cisd_b = bar_index - seq_start

    [cisd_b, cisd_p]



